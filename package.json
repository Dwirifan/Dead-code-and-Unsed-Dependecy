{
  "name": "deadkiller-cli",
  "version": "1.0.8",
  "type": "module",
  "main": "./bin/dce-cli.js",
  "bin": {
    "deadkiller": "./bin/dce-cli.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test && npm pack --dry-run"
  },
  "keywords": [
    "dead-code",
    "static-analysis",
    "typescript",
    "javascript",
    "cli"
  ],
  "author": "Dwi Rif'an Kurniawan",
  "license": "MIT",
  "description": "Safe dead-code and unused-dependency analysis for JavaScript and TypeScript projects.",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dwirifan/Dead-code-and-Unsed-Dependecy.git"
  },
  "bugs": {
    "url": "https://github.com/Dwirifan/Dead-code-and-Unsed-Dependecy/issues"
  },
  "homepage": "https://github.com/Dwirifan/Dead-code-and-Unsed-Dependecy#readme",
  "dependencies": {
    "@typescript-eslint/scope-manager": "8.65.0",
    "@typescript-eslint/typescript-estree": "8.65.0",
    "@typescript-eslint/visitor-keys": "8.65.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "diff": "^8.0.3",
    "enhanced-resolve": "^5.24.0",
    "estraverse": "^5.3.0",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.10.1",
    "fs-extra": "^11.3.3",
    "get-tsconfig": "^4.14.0",
    "globals": "^17.7.0",
    "inquirer": "^12.11.1",
    "magic-string": "^0.30.21",
    "micromatch": "^4.0.8",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.8.0",
    "vitest": "^4.1.8"
  }
}
