import { describe, it } from 'vitest';
import assert from 'node:assert/strict';
import path from 'path';
import { fileURLToPath } from 'url';
import fs from 'fs-extra';
import os from 'os';

// ── Modul yang diuji ────────────────────────────────────────
import { parseCode }              from '../../src/parser/astParser.js';
import { findDeadCode }           from '../../src/analyzer/deadcode/index.js';
import { buildProjectGraph }      from '../../src/analyzer/graph/projectGraph.js';
import { findUnusedDependencies } from '../../src/analyzer/dependency/dependencyAnalyzer.js';
import { RuleEngine }             from '../../src/analyzer/ruleEngine.js';
import { Scope }                  from '../../src/analyzer/deadcode/core/scope.js';
import { buildCFG, buildCallGraph, analyzePathSensitive } from '../../src/analyzer/deadcode/core/flowAnalyzer.js';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

// â”€â”€ Helper â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
/** Jalankan analisis dead-code pada potongan kode string */
async function analisis(kode, ruleEngine = new RuleEngine()) {
    const ast = await parseCode(kode, 'test.js');
    return findDeadCode(ast, 'test.js', null, ruleEngine);
}

function findByName(results, name) { return results.find(r => r.name === name); }
function hasResult(results, name) { return results.some(r => r.name === name); }
function hasType(results, type) { return results.some(r => r.type === type); }

/** Cek apakah ada hasil dengan nama tertentu */
function adaHasil(results, name) {
    return results.some(r => r.name === name);
}

/** Cari hasil berdasarkan nama */
function cariByName(results, name) {
    return results.find(r => r.name === name);
}

/** Cek apakah ada hasil dengan tipe tertentu */
function adaTipe(results, type) {
    return results.some(r => r.type === type);
}


// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
//  KELOMPOK A â€” AST Analyzer (Pengujian Resmi Iterasi 2)
//  Sumber: ITERASI_2.md, Bagian C. Pengujian Awal
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

describe('[TC-A01 â€“ TC-A04] Deklarasi Dasar & Penugasan Buntu', () => {

    it('TC-A01: Variabel yang tidak pernah dipakai terdeteksi', async () => {
        // const x = 5 tidak pernah dibaca â†’ harus masuk laporan
        const hasil = await analisis(`const x = 5;`);
        assert.ok(adaHasil(hasil, 'x'),
            'Variabel yang tidak pernah dibaca harus terdeteksi sebagai dead code');
    });

    it('TC-A02: Variabel yang dipakai TIDAK terdeteksi', async () => {
        // Variabel dibaca â†’ tidak boleh dilaporkan
        const hasil = await analisis(`const x = 5;\nconsole.log(x);`);
        assert.ok(!adaHasil(hasil, 'x'),
            'Variabel yang dipakai tidak boleh masuk laporan dead code');
    });

    it('TC-A03: Variabel Write-Only (ditulis tapi tidak pernah dibaca) terdeteksi', async () => {
        // x terus ditimpa tanpa pernah dibaca
        const hasil = await analisis(`let x = 0;\nx = 5;`);
        const found = cariByName(hasil, 'x');
        assert.ok(found, 'x harus terdeteksi sebagai dead code');
        assert.strictEqual(found.type, 'WriteOnly',
            'Tipe harus WriteOnly karena hanya ditulis, tidak pernah dibaca');
    });

    it('TC-A04: Kode setelah return tidak dapat dijangkau (Unreachable Code)', async () => {
        // Kode setelah return â†’ DeadCode
        const hasil = await analisis(`function f() {\n  return 1;\n  console.log("unreachable");\n}`);
        assert.ok(adaTipe(hasil, 'DeadCode'),
            'Kode setelah return harus dilaporkan sebagai DeadCode');
    });
});


describe('[TC-A05 â€“ TC-A08] Penelusuran Scope Bercabang', () => {

    it('TC-A05: Variabel di dalam block scope terdeteksi jika tidak dipakai', async () => {
        const hasil = await analisis(`{\n  const inner = 42;\n}`);
        assert.ok(adaHasil(hasil, 'inner'),
            'Variabel di dalam block scope yang tidak dipakai harus terdeteksi');
    });

    it('TC-A06: Variabel yang dipakai di dalam fungsi bersarang (closure) TIDAK terdeteksi', async () => {
        const kode = `const x = 10;\nfunction show() { return x; }\nshow();`;
        const hasil = await analisis(kode);
        assert.ok(!adaHasil(hasil, 'x'),
            'Variabel yang dibaca lewat closure tidak boleh dilaporkan');
    });

    it('TC-A07: Fungsi rekursif yang tidak dipanggil dari luar terdeteksi', async () => {
        // factorial hanya memanggil dirinya sendiri â†’ self-reference tidak dihitung
        const kode = `function factorial(n) {\n  if (n <= 1) return 1;\n  return n * factorial(n - 1);\n}`;
        const hasil = await analisis(kode);
        assert.ok(adaHasil(hasil, 'factorial'),
            'Fungsi rekursif tanpa pemanggilan eksternal harus terdeteksi sebagai unused');
    });

    it('TC-A08: Fungsi rekursif yang dipanggil dari luar TIDAK terdeteksi', async () => {
        const kode = `function factorial(n) {\n  if (n <= 1) return 1;\n  return n * factorial(n - 1);\n}\nfactorial(5);`;
        const hasil = await analisis(kode);
        assert.ok(!adaHasil(hasil, 'factorial'),
            'Fungsi rekursif yang dipanggil dari luar tidak boleh dilaporkan');
    });
});


describe('[TC-A09 â€“ TC-A10] Edge Case: TypeScript Namespace & Enum', () => {

    it('TC-A09: Unused TypeScript interface terdeteksi sebagai UnusedType', async () => {
        // Interface yang tidak dipakai harus dilaporkan dengan tipe UnusedType
        const hasil = await analisis(`interface MyInterface { a: string; }`);
        const found = cariByName(hasil, 'MyInterface');
        assert.ok(found,
            'Interface TypeScript yang tidak dipakai harus terdeteksi');
        assert.strictEqual(found.type, 'UnusedType',
            'Tipe laporan harus UnusedType untuk TypeScript interface');
    });

    it('TC-A10: Unused TypeScript type alias terdeteksi sebagai UnusedType', async () => {
        // type alias yang tidak dipakai harus dilaporkan
        const hasil = await analisis(`type MyType = string | number;`);
        const found = cariByName(hasil, 'MyType');
        assert.ok(found,
            'Type alias TypeScript yang tidak dipakai harus terdeteksi');
        assert.strictEqual(found.type, 'UnusedType',
            'Tipe laporan harus UnusedType untuk TypeScript type alias');
    });
});


